[req]
distinguished_name = dn
prompt = no
req_extensions = req_ext
[dn]
CN = Science Assistant
O = Scientific Research
OU = MCP Services
[req_ext]
subjectAltName = @alt_names
extendedKeyUsage = serverAuth
keyUsage = digitalSignature,keyEncipherment
[alt_names]
DNS.1 = science-assistant
DNS.2 = science-assistant-vvz
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = 172.18.0.1
